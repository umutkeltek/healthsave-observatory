{
  "$defs": {
    "PluginCapability": {
      "additionalProperties": false,
      "description": "A capability a plugin declares it needs.\n\nCapabilities use the ``read:<scope>`` / ``write:<scope>`` form\n(e.g. ``read:hrv``, ``write:notifications``) so the policy layer\ncan match on prefix.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "PluginCapability",
      "type": "object"
    },
    "PluginPermissions": {
      "additionalProperties": false,
      "description": "Runtime permissions a plugin requests.",
      "properties": {
        "capabilities": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PluginCapability"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "network": {
          "default": false,
          "title": "Network",
          "type": "boolean"
        },
        "secrets": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Secrets",
          "type": "array"
        }
      },
      "title": "PluginPermissions",
      "type": "object"
    },
    "SourceCapability": {
      "additionalProperties": false,
      "description": "What a Source plugin claims it can produce.\n\nDeclared in the plugin manifest; used by the ingestion runtime\nfor scheduling and by the dashboard for \"available sources\" UI.",
      "properties": {
        "aggregation_scope": {
          "anyOf": [
            {
              "enum": [
                "interval_component",
                "device_day_total",
                "provider_account_day_total",
                "provider_reconciled_day_total",
                "owner_all_source_day_total"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aggregation Scope"
        },
        "auth_required": {
          "default": false,
          "title": "Auth Required",
          "type": "boolean"
        },
        "credential_ownership": {
          "default": "none",
          "enum": [
            "none",
            "operator",
            "owner",
            "client"
          ],
          "title": "Credential Ownership",
          "type": "string"
        },
        "delivery": {
          "enum": [
            "polling",
            "webhook",
            "stream",
            "client_push",
            "manual_import"
          ],
          "title": "Delivery",
          "type": "string"
        },
        "delivery_modes": {
          "default": [],
          "items": {
            "enum": [
              "polling",
              "webhook",
              "stream",
              "client_push",
              "manual_import"
            ],
            "type": "string"
          },
          "title": "Delivery Modes",
          "type": "array"
        },
        "identity_priority": {
          "default": [],
          "items": {
            "enum": [
              "provider_subject_id",
              "provider_object_id",
              "source_record_uid",
              "device_identity_link",
              "device_external_id",
              "client_generated_id",
              "package_name",
              "time_interval"
            ],
            "type": "string"
          },
          "title": "Identity Priority",
          "type": "array"
        },
        "metrics": {
          "items": {
            "type": "string"
          },
          "title": "Metrics",
          "type": "array"
        },
        "plugin_id": {
          "title": "Plugin Id",
          "type": "string"
        },
        "rate_limit_per_minute": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate Limit Per Minute"
        },
        "record_shape": {
          "anyOf": [
            {
              "enum": [
                "sample",
                "interval",
                "session",
                "daily_total",
                "aggregate"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Shape"
        }
      },
      "required": [
        "plugin_id",
        "metrics",
        "delivery"
      ],
      "title": "SourceCapability",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Every plugin's plugin.yaml validates against this.\n\n``sdk_version`` is the SDK version range the plugin targets\n(semver, e.g. ``\">=0.1,<0.2\"``). The loader rejects plugins\nwhose declared range doesn't include the running core SDK.\nAdding this from day one means we can evolve the SDK contract\nwithout silently breaking community plugins.",
  "properties": {
    "config_schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Config Schema"
    },
    "consumes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Consumes",
      "type": "array"
    },
    "emits": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Emits",
      "type": "array"
    },
    "entrypoint": {
      "title": "Entrypoint",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "source",
        "narrator",
        "agent"
      ],
      "title": "Kind",
      "type": "string"
    },
    "language": {
      "default": "python",
      "enum": [
        "python",
        "typescript"
      ],
      "title": "Language",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "permissions": {
      "$ref": "#/$defs/PluginPermissions",
      "default": {
        "capabilities": [],
        "network": false,
        "secrets": []
      }
    },
    "requires": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Requires",
      "type": "array"
    },
    "sdk_version": {
      "title": "Sdk Version",
      "type": "string"
    },
    "source_capabilities": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SourceCapability"
      },
      "title": "Source Capabilities",
      "type": "array"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "kind",
    "version",
    "sdk_version",
    "entrypoint"
  ],
  "title": "PluginManifest",
  "type": "object"
}
