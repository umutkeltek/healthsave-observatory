    prime_compose_status_cache
    printf '%-18s %-22s %-14s %s\n' "Layer" "Service" "State" "URL"
    printf '%-18s %-22s %-14s %s\n' "database" "db" "$(service_state db)" "127.0.0.1:5432"
    printf '%-18s %-22s %-14s %s\n' "migrations" "migrate" "$(service_state migrate)" ""
    printf '%-18s %-22s %-14s %s\n' "api" "api" "$(service_state api)" "$API_URL_DEFAULT"
