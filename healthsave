    printf '"uv":%s,' "$(json_bool "$(tool_flag uv)")"
    printf '"npx":%s,' "$(json_bool "$(tool_flag npx)")"
    printf '"bunx":%s,' "$(json_bool "$(tool_flag bunx)")"
