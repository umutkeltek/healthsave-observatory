cmd_up() {
  require_docker

  local compose_args=()
  local wants_home_assistant=0
  local wants_mqtt=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --ai|--local-ai)
        compose_args+=(--profile local-ai)
        ;;
      --agents)
        compose_args+=(--profile agents)
        ;;
      --mqtt)
        compose_args+=(--profile mosquitto)
        wants_mqtt=1
        ;;
      --home-assistant|--ha)
        compose_args+=(--profile home-assistant)
        wants_home_assistant=1
        ;;
      --all-optional)
        compose_args+=(--profile local-ai --profile agents --profile mosquitto --profile home-assistant)
        wants_home_assistant=1
        wants_mqtt=1
        ;;
            -h|--help)
                print_up_usage
                return 0
                ;;
            *)
                log_error "Unknown up flag: $1"
                print_up_usage
                exit 2
                ;;
        esac
    shift
  done

  if [ "$wants_home_assistant" = "1" ]; then
    ensure_env_value "HA_MQTT_ENABLED" "true"
    local broker
    broker="${HA_MQTT_BROKER:-$(read_env_value HA_MQTT_BROKER)}"
    if { [ -z "$broker" ] || [ "$broker" = "mqtt" ]; } && [ "$wants_mqtt" = "0" ]; then
      log_info "Including bundled MQTT broker for Home Assistant bridge."
      compose_args+=(--profile mosquitto)
    fi
  fi

  docker compose "${compose_args[@]}" up -d
    log_info "Waiting for API readiness on ${API_URL_DEFAULT}/ready..."
    if wait_for_api_ready; then
        log_ok "API ready."
    else
        log_warn "API did not become ready within 120 seconds. Run 'healthsave logs api'."
    fi
}

