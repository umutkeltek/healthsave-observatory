        ok=0
    fi

    printf '{'
    printf '"ok":%s,' "$(json_bool "$ok")"
    printf '"version":"%s",' "$(json_escape "$VERSION")"
    printf '"script_dir":"%s",' "$(json_escape "$CLI_DIR")"
    printf '"platform":{"id":"%s","note":"%s"},' "$(json_escape "$(platform_id)")" "$(json_escape "$(platform_note)")"
    printf '"tools":{'
