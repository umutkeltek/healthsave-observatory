cmd_status() {
    local json_mode="$1"
    if [ "$json_mode" = "1" ]; then
        cmd_status_json
    else
        cmd_status_human
    fi
}

print_check_line() {
    local ok="$1"
    local label="$2"
    local detail="${3:-}"
    if [ "$ok" = "1" ]; then
        log_ok "$label${detail:+ - $detail}"
    else
        log_error "$label${detail:+ - $detail}"
    fi
}

cmd_doctor_human() {
    local failures=0
    local docker_cli
    local docker_daemon
    local docker_compose
    local curl_ok

    docker_cli="$(docker_cli_flag)"
    docker_daemon="$(docker_daemon_flag)"
    docker_compose="$(docker_compose_flag)"
    curl_ok="$(tool_flag curl)"
    prime_compose_status_cache

    log_info "HealthSave Observatory doctor"
    log_info "Platform: $(platform_id) - $(platform_note)"

    print_check_line "$docker_cli" "Docker CLI"
    [ "$docker_cli" = "1" ] || failures=$((failures + 1))
    print_check_line "$docker_daemon" "Docker daemon"
    [ "$docker_daemon" = "1" ] || failures=$((failures + 1))
    print_check_line "$docker_compose" "Docker Compose plugin"
    [ "$docker_compose" = "1" ] || failures=$((failures + 1))
    print_check_line "$curl_ok" "curl"
    [ "$curl_ok" = "1" ] || failures=$((failures + 1))

    if [ -f "$ENV_FILE" ]; then
        log_ok "config .env"
    else
        log_error "config .env missing - run 'healthsave setup basic'"
        failures=$((failures + 1))
    fi

    if [ -f "$CONFIG_FILE" ]; then
        log_ok "config config.yaml"
    else
        log_error "config config.yaml missing - run 'healthsave setup basic'"
        failures=$((failures + 1))
    fi

    if [ "$docker_daemon" = "1" ] && [ "$docker_compose" = "1" ]; then
        echo
        cmd_status_human
        echo

        if service_is_running db; then log_ok "layer database"; else log_error "layer database"; failures=$((failures + 1)); fi
        if migration_is_ok; then log_ok "layer migrations"; else log_error "layer migrations"; failures=$((failures + 1)); fi
        if service_is_running api; then log_ok "layer api service"; else log_error "layer api service"; failures=$((failures + 1)); fi
        if service_is_running worker; then log_ok "layer worker"; else log_error "layer worker"; failures=$((failures + 1)); fi
        if service_is_running web; then log_ok "layer Observatory web service"; else log_error "layer Observatory web service"; failures=$((failures + 1)); fi
        if service_is_running grafana; then log_ok "layer Grafana service"; else log_error "layer Grafana service"; failures=$((failures + 1)); fi

        if endpoint_ok "${API_URL_DEFAULT}/health"; then
            log_ok "API /health"
        else
            log_error "API /health"
            failures=$((failures + 1))
        fi
        if endpoint_ok "${API_URL_DEFAULT}/ready"; then
            log_ok "API /ready"
        else
            log_error "API /ready"
            failures=$((failures + 1))
        fi
        if endpoint_ok "${WEB_URL_DEFAULT}/"; then
            log_ok "Observatory web ${WEB_URL_DEFAULT}"
        else
            log_error "Observatory web ${WEB_URL_DEFAULT}"
            failures=$((failures + 1))
        fi
        if endpoint_ok "${GRAFANA_URL_DEFAULT}/"; then
            log_ok "Grafana ${GRAFANA_URL_DEFAULT}"
        else
            log_error "Grafana ${GRAFANA_URL_DEFAULT}"
            failures=$((failures + 1))
        fi

        if [ "$(service_state ollama)" != "not_created" ]; then
            if ollama_service_ok; then
                log_ok "optional local AI ollama"
            else
                log_warn "optional local AI ollama is present but not healthy"
            fi
        else
            log_info "optional local AI: disabled"
        fi
    fi

    echo
    if [ "$failures" -gt 0 ]; then
        log_error "Doctor found ${failures} issue(s). Run 'healthsave logs <layer>' for details."
        exit 1
    fi

    print_connection_summary
}

