json_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

json_bool() {
    if [ "$1" = "1" ]; then
        printf 'true'
    else
        printf 'false'
    fi
}

json_string_or_null() {
    if [ -n "$1" ]; then
        printf '"%s"' "$(json_escape "$1")"
    else
        printf 'null'
    fi
}

tool_flag() {
    if command -v "$1" >/dev/null 2>&1; then
        printf '1'
    else
        printf '0'
    fi
}

docker_cli_flag() {
    tool_flag docker
}

docker_daemon_flag() {
    if docker_available_cached; then
        printf '1'
    else
        printf '0'
    fi
}

docker_compose_flag() {
    if docker_available_cached && run_with_timeout 2 docker compose version >/dev/null 2>&1; then
        printf '1'
    else
        printf '0'
    fi
}

platform_id() {
    local uname_s
    uname_s="$(uname -s 2>/dev/null || printf 'unknown')"
    case "$uname_s" in
        Darwin)
            printf 'macos'
            ;;
        Linux)
            if [ -r /proc/version ] && grep -qiE 'microsoft|wsl' /proc/version 2>/dev/null; then
                printf 'windows-wsl2'
            else
                printf 'linux'
            fi
            ;;
        MINGW*|MSYS*|CYGWIN*)
            printf 'windows-bash'
            ;;
        *)
            printf '%s' "$uname_s"
            ;;
    esac
}

platform_note() {
    case "$(platform_id)" in
        macos)
            printf 'Supported native path. Use Docker Desktop or another Docker daemon.'
            ;;
        linux)
            printf 'Supported native path. Use Docker Engine or Docker Desktop.'
            ;;
        windows-wsl2)
            printf 'Supported Windows path. Run inside WSL2 with Docker Desktop WSL integration enabled.'
            ;;
        windows-bash)
            printf 'Use WSL2 for the supported Windows path; Git Bash/MSYS shells are best-effort.'
            ;;
        *)
            printf 'Unknown platform. Docker Compose plus Bash are required.'
            ;;
    esac
}

require_docker() {
    if ! docker_available; then
        log_error "Docker is not running. Start Docker Desktop or Docker daemon first."
        exit 1
    fi
}

DOCKER_AVAILABLE_CACHE=""
COMPOSE_PS_CACHE=""
COMPOSE_PS_CACHE_LOADED=0
docker_available_cached() {
    if [ "$DOCKER_AVAILABLE_CACHE" = "1" ]; then
        return 0
    fi
    if [ "$DOCKER_AVAILABLE_CACHE" = "0" ]; then
        return 1
    fi
    if docker_available; then
        DOCKER_AVAILABLE_CACHE=1
        return 0
    fi
    DOCKER_AVAILABLE_CACHE=0
    return 1
}

compose_ps_lines() {
    if ! docker_available_cached; then
        return 1
    fi
    if [ "$COMPOSE_PS_CACHE_LOADED" = "1" ]; then
        printf '%s\n' "$COMPOSE_PS_CACHE"
        return 0
    fi
    COMPOSE_PS_CACHE="$(run_with_timeout 0.5 docker compose ps -a --format '{{.Service}}|{{.State}}|{{.ExitCode}}' 2>/dev/null || true)"
    COMPOSE_PS_CACHE_LOADED=1
    printf '%s\n' "$COMPOSE_PS_CACHE"
}

prime_compose_status_cache() {
    if docker_available_cached; then
        compose_ps_lines >/dev/null 2>&1 || true
    fi
}

service_row() {
    local service="$1"
    local output
    output="$(compose_ps_lines 2>/dev/null || true)"
    printf '%s\n' "$output" | awk -F'|' -v svc="$service" '$1 == svc { print; found = 1; exit } END { if (!found) exit 1 }'
}

service_state() {
    local service="$1"
    local row
    if ! docker_available_cached; then
        printf 'unavailable'
        return
    fi
    row="$(service_row "$service" 2>/dev/null || true)"
    if [ -z "$row" ]; then
        printf 'not_created'
    else
        printf '%s' "$row" | awk -F'|' '{ print $2 }'
    fi
}

service_exit_code() {
    local service="$1"
    local row
    row="$(service_row "$service" 2>/dev/null || true)"
    if [ -z "$row" ]; then
        printf ''
    else
        printf '%s' "$row" | awk -F'|' '{ print $3 }'
    fi
}

service_is_running() {
    [ "$(service_state "$1")" = "running" ]
}

migration_is_ok() {
    local state
    local exit_code
    state="$(service_state migrate)"
    exit_code="$(service_exit_code migrate)"
    [ "$state" = "running" ] || { [ "$state" = "exited" ] && [ "$exit_code" = "0" ]; }
}

endpoint_ok() {
    local url="$1"
    command -v curl >/dev/null 2>&1 && curl -fsS --connect-timeout 1 --max-time 1 "$url" >/dev/null 2>&1
}

ollama_service_ok() {
    service_is_running ollama && docker compose exec -T ollama ollama list >/dev/null 2>&1
}

resolve_service_alias() {
    case "$1" in
        database|postgres|timescale|db) printf 'db' ;;
        migrations|migration|migrate) printf 'migrate' ;;
        api|server) printf 'api' ;;
        worker|jobs|analysis) printf 'worker' ;;
        web|frontend|observatory|obs|ui) printf 'web' ;;
        grafana|dashboards) printf 'grafana' ;;
        ai|local-ai|llm|ollama) printf 'ollama' ;;
        agents|agent) printf 'agents' ;;
        mqtt|mosquitto) printf 'mqtt' ;;
        ha|home-assistant|homeassistant|homeassistant-mqtt) printf 'homeassistant-mqtt' ;;
        *) printf '%s' "$1" ;;
    esac
}

print_connection_summary() {
    local lan_ip
    local grafana_user="admin"
    local grafana_pw

    lan_ip="$(detect_lan_ip)"
    grafana_pw="$(read_env_value GRAFANA_PASSWORD)"

    echo
    log_ok "HealthSave Observatory ready."
    echo "  Observatory web: ${WEB_URL_DEFAULT}"
    echo "  iOS app URL:     http://${lan_ip}:8000"
    echo "  API health:      ${API_URL_DEFAULT}/ready"
    echo "  Grafana:         ${GRAFANA_URL_DEFAULT} (user: ${grafana_user}, pass: ${grafana_pw})"
    echo
    log_info "Next step: healthsave doctor"
}

preview_basic_setup() {
    cat <<EOF
DRY RUN: Basic setup

Would:
1. Check that Docker is installed and running.
2. Create .env with generated DB and Grafana passwords if missing.
3. Create config.yaml from config.yaml.example if missing.
4. Keep local AI disabled unless already configured.
5. Start default layers: database, migrations, API, worker, Observatory web, Grafana.
6. Wait for API readiness.
7. Print HealthSave app URL, Observatory web URL, and Grafana login.

No files would be changed, and Docker would not be started.
EOF
}

preview_advanced_setup() {
    cat <<EOF
DRY RUN: Advanced setup

Would:
1. Check that Docker is installed and running.
2. Prompt for DB password, Grafana password, and optional API key.
3. Prompt for local AI/Ollama enablement.
4. Detect RAM/GPU and recommend an Ollama model if AI is enabled.
5. Start Docker services and pull the selected model if needed.
6. Print HealthSave app URL, Observatory web URL, and Grafana login.

No files would be changed, and Docker would not be started.
EOF
}

cmd_setup_basic() {
    local dry_run="$1"

    if [ "$dry_run" = "1" ]; then
        preview_basic_setup
        return 0
    fi

    log_info "[1/5] Checking Docker"
    require_docker

    log_info "[2/5] Preparing local config"
    if [ -f "$ENV_FILE" ]; then
        log_warn "$ENV_FILE already exists - keeping existing values."
    else
        if [ ! -f "$ENV_EXAMPLE" ]; then
            log_error "$ENV_EXAMPLE missing - cannot generate $ENV_FILE."
            exit 1
        fi
        write_env_file "$(rand_hex)" "$(rand_hex)" ""
        log_ok "Wrote $ENV_FILE with local defaults."
    fi

    if [ -f "$CONFIG_FILE" ]; then
        log_warn "$CONFIG_FILE already exists - keeping existing values."
    else
        if [ ! -f "$CONFIG_EXAMPLE" ]; then
            log_error "$CONFIG_EXAMPLE missing - cannot generate $CONFIG_FILE."
            exit 1
        fi
        cp "$CONFIG_EXAMPLE" "$CONFIG_FILE"
        log_ok "Wrote $CONFIG_FILE from $CONFIG_EXAMPLE."
    fi

    ensure_env_value "ANALYSIS_CONFIG_FILE" "./config.yaml"

    log_info "[3/5] Using Basic mode"
    log_info "Starting DB, API, worker, Observatory web, and Grafana. Local AI questions are skipped."

    log_info "[4/5] Starting Docker services"
    docker compose up -d
    log_info "Waiting for API readiness on ${API_URL_DEFAULT}/ready..."
    if wait_for_api_ready; then
        log_ok "API ready."
    else
        log_warn "API did not become ready within 120 seconds. Run 'healthsave logs api' if doctor fails."
    fi

    log_info "[5/5] Setup summary"
    print_connection_summary
}

cmd_setup_advanced() {
    local dry_run="$1"
    local no_input="$2"

    if [ "$dry_run" = "1" ]; then
        preview_advanced_setup
        return 0
    fi

    if [ "$no_input" = "1" ]; then
        log_error "Advanced setup needs prompts. Use 'healthsave setup basic --no-input' or remove --no-input."
        exit 2
    fi

    if [ ! -t 0 ]; then
        log_error "Advanced setup needs an interactive terminal. Use 'healthsave setup basic --no-input' for automation."
        exit 2
    fi

    cmd_setup
}

cmd_setup_menu() {
    tui_setup_menu
}

cmd_setup_cli() {
    local mode="${1:-}"
    local dry_run=0
    local no_input=0

    if [ "$mode" = "-h" ] || [ "$mode" = "--help" ] || [ "$mode" = "help" ]; then
        print_setup_usage
        return 0
    fi

    if [ "$mode" = "basic" ] || [ "$mode" = "advanced" ]; then
        shift
    else
        mode=""
    fi

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --dry-run)
                dry_run=1
                ;;
            --no-input)
                no_input=1
                ;;
            -h|--help)
                print_setup_usage
                return 0
                ;;
            *)
                log_error "Unknown setup flag: $1"
                print_setup_usage
                exit 2
                ;;
        esac
        shift
    done

    if [ -z "$mode" ]; then
        if [ "$no_input" = "1" ] || [ ! -t 0 ]; then
            log_error "Choose setup mode: healthsave setup basic or healthsave setup advanced."
            print_setup_usage
            exit 2
        fi
        tui_setup_menu
        return 0
    fi

    case "$mode" in
        basic)
            cmd_setup_basic "$dry_run"
            ;;
        advanced)
            cmd_setup_advanced "$dry_run" "$no_input"
            ;;
    esac
}

