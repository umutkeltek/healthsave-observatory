    service_is_running api || required_ok=0
    service_is_running worker || required_ok=0
    service_is_running web || required_ok=0
    service_is_running grafana || required_ok=0
    [ "$api_ready" = "1" ] || required_ok=0
    [ "$web_ready" = "1" ] || required_ok=0
    [ "$grafana_ready" = "1" ] || required_ok=0

