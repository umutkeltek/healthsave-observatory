CLI_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$CLI_DIR"

# Reuse existing setup functions without running setup.sh dispatch.
export HEALTHSAVE_SETUP_TEST=1
# shellcheck source=./setup.sh disable=SC1091
source "$CLI_DIR/setup.sh"

