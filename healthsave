validate_cli_command_name() {
    case "$1" in
        ""|*/*|*\\*|"."|"..")
            log_error "Command name must be a simple executable name, not a path."
            exit 2
            ;;
    esac
}

wrapper_matches_checkout() {
    local target="$1"
    [ -f "$target" ] || return 1
    grep -Fx "$(wrapper_marker)" "$target" >/dev/null 2>&1
}

wrapper_marker() {
    printf '# healthsave-wrapper: %s/healthsave\n' "$CLI_DIR"
}

write_cli_wrapper() {
    local target="$1"
    local target_dir
    local target_base
    local tmp
    target_dir="$(dirname "$target")"
    target_base="$(basename "$target")"
    tmp="$(mktemp "${target_dir}/.${target_base}.tmp.XXXXXX")"
    {
        printf '#!/usr/bin/env bash\n'
        printf '# healthsave-wrapper: %s/healthsave\n' "$CLI_DIR"
        printf 'exec "%s/healthsave" "$@"\n' "$CLI_DIR"
    } >"$tmp"
    chmod +x "$tmp"
    mv -f "$tmp" "$target"
}

cmd_install_cli() {
    local bin_dir="${HOME}/.local/bin"
    local name="healthsave"
    local force=0
    local dry_run=0

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --bin-dir)
                shift
                if [ "$#" -eq 0 ]; then
                    log_error "--bin-dir needs a value"
                    exit 2
                fi
                bin_dir="$1"
                ;;
            --name)
                shift
                if [ "$#" -eq 0 ]; then
                    log_error "--name needs a value"
                    exit 2
                fi
                name="$1"
                ;;
            --force)
                force=1
                ;;
            --dry-run)
                dry_run=1
                ;;
            -h|--help)
                print_install_cli_usage
                return 0
                ;;
            *)
                log_error "Unknown install-cli flag: $1"
                print_install_cli_usage
                exit 2
                ;;
        esac
        shift
    done

    validate_cli_command_name "$name"

    local target="${bin_dir}/${name}"
    local existing
    existing="$(command -v "$name" 2>/dev/null || true)"

    if [ "$dry_run" = "1" ]; then
        echo "Would install wrapper: ${target}"
        echo "Wrapper would execute: ${CLI_DIR}/healthsave"
        if [ -n "$existing" ]; then
            echo "Existing command on PATH: ${existing}"
        fi
        return 0
    fi

    if [ -L "$target" ] && [ "$force" != "1" ]; then
        log_error "${target} is a symlink. Use --force only if you deliberately want to replace it."
        exit 1
    fi

    if [ -e "$target" ] || [ -L "$target" ]; then
        if [ "$force" = "1" ]; then
            rm -f "$target"
        elif ! wrapper_matches_checkout "$target"; then
            log_error "${target} already exists and is not the wrapper from this checkout. Use --force to replace it."
            exit 1
        fi
    fi

    mkdir -p "$bin_dir"
    write_cli_wrapper "$target"
    log_ok "Installed ${name} -> ${CLI_DIR}/healthsave"
    if ! printf ':%s:' "$PATH" | grep -F ":${bin_dir}:" >/dev/null 2>&1; then
        log_warn "${bin_dir} is not on PATH. Add it to your shell profile or run ${target} directly."
    fi
}

cmd_uninstall_cli() {
    local bin_dir="${HOME}/.local/bin"
    local name="healthsave"
    local force=0
    local dry_run=0

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --bin-dir)
                shift
                if [ "$#" -eq 0 ]; then
                    log_error "--bin-dir needs a value"
                    exit 2
                fi
                bin_dir="$1"
                ;;
            --name)
                shift
                if [ "$#" -eq 0 ]; then
                    log_error "--name needs a value"
                    exit 2
                fi
                name="$1"
                ;;
            --force)
                force=1
                ;;
            --dry-run)
                dry_run=1
                ;;
            -h|--help)
                print_uninstall_cli_usage
                return 0
                ;;
            *)
                log_error "Unknown uninstall-cli flag: $1"
                print_uninstall_cli_usage
                exit 2
                ;;
        esac
        shift
    done

    validate_cli_command_name "$name"

    local target="${bin_dir}/${name}"
    if [ "$dry_run" = "1" ]; then
        echo "Would remove wrapper: ${target}"
        return 0
    fi

    if [ ! -e "$target" ] && [ ! -L "$target" ]; then
        log_warn "${target} does not exist."
        return 0
    fi

    if [ -L "$target" ] && [ "$force" != "1" ]; then
        log_error "${target} is a symlink. Use --force only if you deliberately want to remove it."
        exit 1
    fi

    if [ "$force" != "1" ] && ! wrapper_matches_checkout "$target"; then
        log_error "${target} does not look like the wrapper created by this checkout. Use --force to remove it anyway."
        exit 1
    fi

    rm -f "$target"
    log_ok "Removed ${target}"
}

TUI_CURSOR_HIDDEN=0
TUI_CHOICE=0

tui_hide_cursor() {
    [ "$TUI_CURSOR_HIDDEN" = "1" ] && return 0
    printf '\033[?25l' >&2
    TUI_CURSOR_HIDDEN=1
}

tui_show_cursor() {
    [ "$TUI_CURSOR_HIDDEN" = "0" ] && return 0
    printf '\033[?25h' >&2
    TUI_CURSOR_HIDDEN=0
}

tui_clear() {
    printf '\033[2J\033[H' >&2
}

tui_header() {
    local title="$1"
    tui_clear
    printf '%sHealthSave Observatory%s\n' "$COLOR_INFO" "$COLOR_RESET" >&2
    printf '%s%s%s\n\n' "$COLOR_OK" "$title" "$COLOR_RESET" >&2
}

tui_footer() {
    printf '\n%s↑/↓ move · Enter select · q back/quit%s\n' "$COLOR_WARN" "$COLOR_RESET" >&2
}

tui_drain_pending_input() {
    local _
    while IFS= read -rsn1 -t 0 _; do
        :
    done
}

tui_pause() {
    if [ ! -t 0 ]; then
        return 0
    fi
    printf '\n%sPress Enter to continue%s' "$COLOR_WARN" "$COLOR_RESET" >&2
    local _
    read -r _ || true
}

tui_select() {
    local title="$1"
    shift
    local selected=0
    local count="$#"
    local key
    local key2
    local i
    local label
    local old_stty=""

    if [ "$count" -eq 0 ]; then
        return 1
    fi

    if [ ! -t 0 ]; then
        TUI_CHOICE=0
        return 0
    fi

    old_stty="$(stty -g 2>/dev/null || true)"
    if [ -n "$old_stty" ]; then
        stty -echo -icanon min 1 time 0 2>/dev/null || true
    fi

    trap 'tui_show_cursor' RETURN
    tui_hide_cursor

    while true; do
        tui_header "$title"
        i=0
        for label in "$@"; do
            if [ "$i" -eq "$selected" ]; then
                printf '  %s›%s %s%s%s\n' "$COLOR_OK" "$COLOR_RESET" "$COLOR_INFO" "$label" "$COLOR_RESET" >&2
            else
                printf '    %s\n' "$label" >&2
            fi
            i=$((i + 1))
        done
        tui_footer

        IFS= read -rsn1 key || key=""
        case "$key" in
            "")
                [ -n "$old_stty" ] && stty "$old_stty" 2>/dev/null || true
                tui_show_cursor
                TUI_CHOICE="$selected"
                return 0
                ;;
            q|Q)
                tui_drain_pending_input
                [ -n "$old_stty" ] && stty "$old_stty" 2>/dev/null || true
                tui_show_cursor
                TUI_CHOICE=$((count - 1))
                return 0
                ;;
            k|K)
                selected=$((selected - 1))
                ;;
            j|J)
                selected=$((selected + 1))
                ;;
            $'\033')
                IFS= read -rsn2 -t 1 key2 || key2=""
                case "$key2" in
                    "[A")
                        selected=$((selected - 1))
                        ;;
                    "[B")
                        selected=$((selected + 1))
                        ;;
                esac
                ;;
        esac

        if [ "$selected" -lt 0 ]; then
            selected=$((count - 1))
        elif [ "$selected" -ge "$count" ]; then
            selected=0
        fi
    done
}

tui_run() {
    tui_show_cursor
    tui_clear
    "$@"
    local rc=$?
    if [ "$rc" -ne 0 ]; then
        log_warn "Command exited with status ${rc}."
    fi
    tui_pause
    return "$rc"
}

