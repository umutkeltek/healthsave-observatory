layer_health_flag() {
    local layer="$1"
    case "$layer" in
        database)
            service_is_running db && printf '1' || printf '0'
            ;;
        migrations)
            migration_is_ok && printf '1' || printf '0'
            ;;
        api)
            service_is_running api && endpoint_ok "${API_URL_DEFAULT}/ready" && printf '1' || printf '0'
            ;;
        worker)
            service_is_running worker && printf '1' || printf '0'
            ;;
        web)
            service_is_running web && endpoint_ok "${WEB_URL_DEFAULT}/" && printf '1' || printf '0'
            ;;
        grafana)
            service_is_running grafana && endpoint_ok "${GRAFANA_URL_DEFAULT}/" && printf '1' || printf '0'
            ;;
        local_ai)
            ollama_service_ok && printf '1' || printf '0'
            ;;
        agents)
            service_is_running agents && printf '1' || printf '0'
            ;;
        mqtt)
            service_is_running mqtt && printf '1' || printf '0'
            ;;
        home_assistant)
            service_is_running homeassistant-mqtt && printf '1' || printf '0'
            ;;
    esac
}

json_layer_status() {
    local key="$1"
    local service="$2"
    local required="$3"
    local profile="$4"
    local url="$5"
    local status
    local healthy

    status="$(service_state "$service")"
    healthy="$(layer_health_flag "$key")"

    printf '"%s":{' "$(json_escape "$key")"
    printf '"service":"%s",' "$(json_escape "$service")"
    printf '"required":%s,' "$(json_bool "$required")"
    printf '"profile":'
    json_string_or_null "$profile"
    printf ','
    printf '"status":"%s",' "$(json_escape "$status")"
    printf '"healthy":%s,' "$(json_bool "$healthy")"
    printf '"url":'
    json_string_or_null "$url"
    printf '}'
}

