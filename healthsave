    printf '%-18s %-22s %-14s %s\n' "web" "web" "$(service_state web)" "$WEB_URL_DEFAULT"
    printf '%-18s %-22s %-14s %s\n' "grafana" "grafana" "$(service_state grafana)" "$GRAFANA_URL_DEFAULT"
    printf '%-18s %-22s %-14s %s\n' "local-ai" "ollama" "$(service_state ollama)" "optional"
