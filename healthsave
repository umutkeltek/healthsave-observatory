    local ok=1

    docker_cli="$(docker_cli_flag)"
    docker_daemon="$(docker_daemon_flag)"
    docker_compose="$(docker_compose_flag)"
    curl_ok="$(tool_flag curl)"
    prime_compose_status_cache
    env_file=0
    config_file=0
    api_ready=0
    web_ready=0
    grafana_ready=0

    [ -f "$ENV_FILE" ] && env_file=1
    [ -f "$CONFIG_FILE" ] && config_file=1
