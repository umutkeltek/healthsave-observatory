json_layer_static() {
    local key="$1"
    local label="$2"
    local service="$3"
    local required="$4"
    local profile="$5"
    local url="$6"
    local description="$7"

    printf '"%s":{' "$(json_escape "$key")"
    printf '"label":"%s",' "$(json_escape "$label")"
    printf '"service":"%s",' "$(json_escape "$service")"
    printf '"required":%s,' "$(json_bool "$required")"
    printf '"profile":'
    json_string_or_null "$profile"
    printf ','
    printf '"url":'
    json_string_or_null "$url"
    printf ','
    printf '"description":"%s"' "$(json_escape "$description")"
    printf '}'
}

