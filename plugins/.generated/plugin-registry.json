            },
            {
              "description": "Outbound HTTPS to Google OAuth token endpoint.",
              "name": "network:oauth2.googleapis.com"
            },
            {
              "description": "Browser authorization endpoint for operator account binding.",
              "name": "network:accounts.google.com"
            }
          ],
          "network": true,
          "secrets": [
            "GOOGLE_HEALTH_CLIENT_ID",
            "GOOGLE_HEALTH_CLIENT_SECRET",
            "GOOGLE_HEALTH_REDIRECT_URI",
            "HDH_TOKEN_ENC_KEY"
          ]
        },
