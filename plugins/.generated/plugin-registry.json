  "plugins": [
    {
      "compatible_with_running_sdk": true,
      "id": "hdh.agents.anomaly_watcher",
      "kind": "agent",
      "manifest": {
        "config_schema": null,
        "consumes": [
          "finding.anomaly"
        ],
        "emits": [
          "proposal.notify"
        ],
        "entrypoint": "plugins.agents.anomaly_watcher:AnomalyWatcherAgent",
        "id": "hdh.agents.anomaly_watcher",
        "kind": "agent",
        "language": "python",
        "name": "Anomaly Watcher",
        "permissions": {
          "capabilities": [
            {
              "description": "Read anomaly findings to detect alert-worthy events.",
              "name": "read:analysis_findings"
            },
            {
              "description": "Propose user-facing notifications. The decision belongs to the operator (or a future auto-approval policy); the agent does not deliver notifications itself.",
              "name": "propose:notify"
            }
          ],
          "network": false,
          "secrets": []
        },
        "requires": [],
        "sdk_version": ">=0.1,<0.2",
        "source_capabilities": [],
        "version": "0.1.0"
      },
      "plugin_dir": "plugins/agents/anomaly_watcher"
    },
    {
      "compatible_with_running_sdk": true,
      "id": "amazfit-zepp",
      "kind": "source",
      "manifest": {
        "config_schema": null,
        "consumes": [],
        "emits": [
          "measurement.heart_rate",
          "measurement.blood_oxygen",
          "measurement.sleep_analysis",
          "measurement.stress",
          "measurement.daily_activity"
        ],
        "entrypoint": "plugins.sources.amazfit:AmazfitSource",
        "id": "amazfit-zepp",
        "kind": "source",
        "language": "python",
        "name": "Amazfit / Zepp",
        "permissions": {
          "capabilities": [
            {
              "description": "Persist the operator-imported Zepp app_token (re-imported on expiry).",
              "name": "write:oauth_tokens"
            },
            {
              "description": "Insert heart rate, SpO2, sleep, stress, and daily activity rows into the per-metric Timescale tables.",
              "name": "write:measurements"
            },
            {
              "description": "Outbound HTTPS for the US-region Zepp data API.",
              "name": "network:api-mifit-us3.zepp.com"
            },
            {
              "description": "Outbound HTTPS for the EU-region Zepp data API.",
              "name": "network:api-mifit-de.zepp.com"
            },
            {
              "description": "Outbound HTTPS for the CN-region Zepp data API.",
              "name": "network:api-mifit.zepp.com"
            }
          ],
          "network": true,
          "secrets": [
            "AMAZFIT_APP_TOKEN",
            "AMAZFIT_USER_ID",
            "AMAZFIT_REGION",
            "HDH_TOKEN_ENC_KEY"
          ]
        },
        "requires": [],
        "sdk_version": ">=0.1,<0.2",
        "source_capabilities": [
          {
            "aggregation_scope": "interval_component",
            "auth_required": false,
            "credential_ownership": "operator",
            "delivery": "polling",
            "delivery_modes": [
              "polling"
            ],
            "identity_priority": [
              "provider_subject_id",
              "source_record_uid",
              "device_external_id",
              "time_interval"
            ],
            "metrics": [
              "measurement.heart_rate",
              "measurement.blood_oxygen",
              "measurement.stress"
            ],
            "plugin_id": "amazfit-zepp",
            "rate_limit_per_minute": null,
            "record_shape": "sample"
          },
          {
            "aggregation_scope": "interval_component",
            "auth_required": false,
            "credential_ownership": "operator",
            "delivery": "polling",
            "delivery_modes": [
              "polling"
            ],
            "identity_priority": [
              "provider_subject_id",
              "source_record_uid",
              "device_external_id",
              "time_interval"
            ],
            "metrics": [
              "measurement.sleep_analysis"
            ],
            "plugin_id": "amazfit-zepp",
            "rate_limit_per_minute": null,
            "record_shape": "session"
          },
          {
            "aggregation_scope": "provider_account_day_total",
            "auth_required": false,
            "credential_ownership": "operator",
            "delivery": "polling",
            "delivery_modes": [
              "polling"
            ],
            "identity_priority": [
              "provider_subject_id",
              "source_record_uid",
              "time_interval"
            ],
            "metrics": [
              "measurement.daily_activity"
            ],
            "plugin_id": "amazfit-zepp",
            "rate_limit_per_minute": null,
            "record_shape": "daily_total"
          }
        ],
        "version": "0.2.0"
      },
      "plugin_dir": "plugins/sources/amazfit"
    },
