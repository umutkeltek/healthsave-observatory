          {
            "aggregation_scope": "provider_account_day_total",
            "auth_required": false,
            "credential_ownership": "owner",
            "delivery": "polling",
            "delivery_modes": [
              "polling"
            ],
            "identity_priority": [
              "provider_subject_id",
              "provider_object_id",
              "time_interval"
            ],
            "metrics": [
              "measurement.step_count"
            ],
            "plugin_id": "google-health-api",
            "rate_limit_per_minute": null,
            "record_shape": "daily_total"
          }
        ],
        "version": "0.1.0"
